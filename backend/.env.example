# ===== AI Escape Room - Backend 환경 변수 =====
# 지금은 API 키를 사용하지 않으므로 AI_PROVIDER=mock 으로 동작합니다.
# 실제 LLM을 붙일 때 AI_PROVIDER 를 claude 또는 gemini 로 바꾸고 AI_API_KEY 를 채우세요.

# production 이면 기본 관리자 비밀번호로는 서버가 시작되지 않습니다
APP_ENV=development

# SQLite 파일 경로 (backend 폴더 기준 상대경로 가능)
DATABASE_PATH=escape_room.db

# 인게임 관리자 모드 비밀번호 — 반드시 바꾸세요 (기본값이면 서버가 경고를 출력합니다)
# 12자 이상, 문자 종류 2가지 이상 (운영 환경에서는 기본값·약한 비밀번호면 서버가 시작하지 않음)
ADMIN_PASSWORD=change-me
# 관리자 로그인 유지 시간(초)
ADMIN_TOKEN_TTL_SEC=7200

# 힌트 1회 감점: 제한 시간 30분당 몇 초 (기본 60 → 30분 게임 1분, 60분 2분, 90분 3분, 120분 4분). 0 이면 감점 없음
# 난이도 배율: 쉬움 ×0.5, 보통 ×1, 어려움 ×1.5
HINT_PENALTY_SEC=60
# 이보다 오래된 게임 세션은 서버 시작 시 삭제 (시간)
SESSION_KEEP_HOURS=24

# AI 설정: mock | claude | gemini
#  - gemini 무료 키: https://aistudio.google.com/apikey 에서 발급
#  - AI_MODEL 을 비우면 claude → claude-sonnet-5-5, gemini → gemini-2.5-flash
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# AI 응답 최대 대기 시간(초). 게임 시작 시 방 생성도 이 시간 안에 끝난 방만 사용
AI_TIMEOUT_SEC=30
# 키가 있으면 게임을 시작할 때마다 AI 가 모든 방의 문제를 새로 만든다 (false: 테마의 기본 방 사용, 무료 한도 절약)
AI_RANDOM_ROOMS=true
# AI 비용 보호 (넘으면 오류 없이 테마의 기본 방 / 기본 힌트로 진행)
#  - 서버 전체 하루 AI 호출 수 (방 생성·힌트·관리자 생성 모두 포함, 0 이하 = 제한 없음)
AI_DAILY_LIMIT=100
#  - 같은 IP 가 1시간에 만들 수 있는 AI 게임 수
AI_GAMES_PER_IP_HOUR=5
#  - 동시에 AI 로 방을 만드는 게임 수
AI_MAX_CONCURRENT_GAMES=2

# nginx 등 리버스 프록시 뒤에서 실행할 때만 true (관리자 로그인 제한에 실제 접속 IP 사용)
TRUST_PROXY=false

# 프론트엔드 주소 (CORS, 콤마로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
