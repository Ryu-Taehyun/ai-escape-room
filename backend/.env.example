# ===== AI Escape Room - Backend 환경 변수 =====
# 지금은 API 키를 사용하지 않으므로 AI_PROVIDER=mock 으로 동작합니다.
# 실제 LLM을 붙일 때 AI_PROVIDER 를 claude 또는 gemini 로 바꾸고 AI_API_KEY 를 채우세요.

APP_ENV=development

# SQLite 파일 경로 (backend 폴더 기준 상대경로 가능)
DATABASE_PATH=escape_room.db

# 인게임 관리자 모드 비밀번호 — 반드시 바꾸세요 (기본값이면 서버가 경고를 출력합니다)
ADMIN_PASSWORD=change-me
# 관리자 로그인 유지 시간(초)
ADMIN_TOKEN_TTL_SEC=7200

# 힌트 1회당 줄어드는 제한 시간(초). 0 이면 감점 없음
HINT_PENALTY_SEC=60
# 이보다 오래된 게임 세션은 서버 시작 시 삭제 (시간)
SESSION_KEEP_HOURS=24

# AI 설정: mock | claude | gemini
#  - gemini 무료 키: https://aistudio.google.com/apikey 에서 발급
#  - AI_MODEL 을 비우면 claude → claude-sonnet-5-5, gemini → gemini-2.5-flash
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SEC=30

# 프론트엔드 주소 (CORS, 콤마로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
