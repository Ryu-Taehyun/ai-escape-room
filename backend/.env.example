# ===== AI Escape Room - Backend 환경 변수 =====
# 지금은 API 키를 사용하지 않으므로 AI_PROVIDER=mock 으로 동작합니다.
# 나중에 실제 LLM을 붙일 때 AI_PROVIDER=claude 로 바꾸고 AI_API_KEY 를 채우세요.

APP_ENV=development

# SQLite 파일 경로 (backend 폴더 기준 상대경로 가능)
DATABASE_PATH=escape_room.db

# 인게임 관리자 모드 비밀번호 (배포 전 반드시 변경)
ADMIN_PASSWORD=admin1234

# AI 설정: mock | claude
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SEC=30

# 프론트엔드 주소 (CORS, 콤마로 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
